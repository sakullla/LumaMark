{
  "manifest_version": 2,
  "name": "LumaMark",
  "version": "0.1.0",
  "description": "Local-first cross-browser bookmarks",
  "icons": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png", "128": "assets/icons/icon-128.png" },
  "permissions": ["storage", "contextMenus", "commands", "notifications", "tabs", "alarms", "bookmarks", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "browser_action": { "default_title": "Save to LumaMark", "default_popup": "popup.html", "default_icon": { "16": "assets/icons/icon-16.png", "32": "assets/icons/icon-32.png", "48": "assets/icons/icon-48.png" } },
  "commands": { "save-current-page": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Save the current page to LumaMark" } },
  "options_ui": { "page": "settings.html", "open_in_tab": true },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"] }]
}
