{
  "manifest_version": 3,
  "name": "LumaMark",
  "version": "0.1.0",
  "description": "Local-first cross-browser bookmarks",
  "permissions": ["storage", "contextMenus", "commands", "notifications", "tabs"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Save to LumaMark", "default_popup": "popup.html" },
  "commands": { "save-current-page": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Save the current page to LumaMark" } },
  "options_page": "settings.html",
  "chrome_url_overrides": { "newtab": "home.html" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"] }]
}
